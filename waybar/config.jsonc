{
    "layer": "top",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["tray", "hyprland/language", "network", "pulseaudio", "clock"],
    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}",
        "timezone": "Europe/Kyiv"
    },
"network": {
	"interface": "wlp9s0f3u1",
	"format": "{ifname}",
	"format-wifi": "",
	"format-ethernet": "{ifname} ",
	"format-disconnected": "", //An empty format will hide the module.
	"tooltip-format": "{ifname}",
	"tooltip-format-wifi": "{essid} ({signalStrength}%) ",
	"tooltip-format-ethernet": "{ifname} ",
	"tooltip-format-disconnected": "Disconnected",
	"max-length": 50
},
    "tray": {
	"icon-size": 21,
	"spacing": 10,
	"icons": {
		"blueman": "bluetooth",
		"TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png",
		"spotify": false,
		"nm-applet": false,
	},
	"orders": {
		"wechat": 99
	}
},
"pulseaudio": {
	"format": "{volume}% {icon}",
	"format-bluetooth": "{volume}% {icon}",
	"format-muted": "",
	"format-icons": {
		"alsa_output.pci-0000_00_1f.3.analog-stereo": "",
		"alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
		"headphone": "",
		"hands-free": "󰂑",
		"headset": "󰂑",
		"phone": "",
		"phone-muted": "",
		"portable": "",
		"car": "",
		"default": ["", ""]
	},
	"scroll-step": 1,
    "on-click": "~/.config/waybar/scripts/audio-rofi.sh sink",
    "on-click-right": "~/.config/waybar/scripts/audio-rofi.sh source"
},
"hyprland/workspaces": {
	"format": "{name}",
	"format-icons": {
		"active": "",
		"default": ""
	},
	"persistent-workspaces": {
		"*": 0, // 5 workspaces by default on every monitor
		"HDMI-A-1": 0 // but only three on HDMI-A-1
	},
},
"hyprland/language": {
	"format": "{}",
	"format-en": "US",
	"format-Ukrainian": "UA",
	"format-ru": "RU",
	"tooltip": true,
	"tooltip-format": "{}",
	"tooltip-format-es": "{Español}",
	"tooltip-format-en": "{English (american)}"
},
"custom/power": {
    "format" : "⏻ ",
        "tooltip": false,
		"on-click": "~/.config/waybar/scripts/power.sh"
},
"memory": {
	"interval": 1,
	"format": "{used:0.1f}G/{total:0.1f}G "
},
"cava": {
    "exec": "cava -p ~/.config/cava/config",
    "framerate": 30,
    "bars": 10,
    "lower_cutoff_freq": 50,
    "higher_cutoff_freq": 10000,
    "method": "pipewire",
    "source": "auto",
    "stereo": true,
    "bar_delimiter": 0,
    "format-icons": [" ", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
},
"hyprland/window": {
	"format": "{}",
	"rewrite": {
		"(.*) - Mozilla Firefox": "🌎 $1",
		"(.*) - zsh": "> [$1]"
	}
}
}
